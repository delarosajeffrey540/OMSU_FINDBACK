APP_ENV=development
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=omsu_findback
DB_USER=root
DB_PASSWORD=
# Or set DATABASE_URL=mysql+pymysql://user:password@host:3306/omsu_findback?charset=utf8mb4
# DATABASE_URL=

# Optional SMTP. Leave unset for in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# Use a shared Redis URL in production; memory:// is local-development only.
RATELIMIT_STORAGE_URI=memory://
AI_MODEL_PATH=yolov8n.pt
TRUST_PROXY=false
# Set to an absolute, private folder in production.
# UPLOAD_FOLDER=
